with "config/ada_adventure_config.gpr";
project Ada_Adventure is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Ada_Adventure_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("ada_adventure.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-Og", "-g", "-gnat2012");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Switches ("Ada") use
        ("-lSDL2", "-lSDL2_image", "-lSDL2_mixer", "-lSDL2_ttf");
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Ada_Adventure;
